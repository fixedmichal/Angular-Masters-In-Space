{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "space-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/space-app",
      "sourceRoot": "projects/space-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "allowedCommonJsDependencies": ["darian-system", "html2canvas"],
            "outputPath": "dist/space-app",
            "index": "projects/space-app/src/index.html",
            "browser": "projects/space-app/src/main.ts",
            "polyfills": [
            ],
            "tsConfig": "projects/space-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/space-app/public"
              },
              {                
                "input": "dist/shared-lib/assets",
                "glob": "*",
                "output": "assets"
               }
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["projects/shared-styles"]
            },
            "styles": ["projects/space-app/src/styles.scss"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "25kb",
                  "maximumError": "30kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/space-app/src/environments/environment.ts",
                  "with": "projects/space-app/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "space-app:build:production"
            },
            "development": {
              "port": 4500,
              "buildTarget": "space-app:build:development"
            }
          },
          "options": {
            "proxyConfig": "projects/space-app/src/proxy.conf.json"
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "space-app:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
            ],
            "tsConfig": "projects/space-app/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/space-app/public"
              },
              {                
                "input": "dist/shared-lib/assets",
                "glob": "*",
                "output": "assets"
               }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/shared-styles"
              ]
            },
            "styles": [
              "projects/space-app/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "shared-lib": {
      "projectType": "library",
      "root": "projects/shared-lib",
      "sourceRoot": "projects/shared-lib/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/shared-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/shared-lib/tsconfig.spec.json"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": { "type": "component" },
    "@schematics/angular:directive": { "type": "directive" },
    "@schematics/angular:service": { "type": "service" },
    "@schematics/angular:guard": { "typeSeparator": "." },
    "@schematics/angular:interceptor": { "typeSeparator": "." },
    "@schematics/angular:module": { "typeSeparator": "." },
    "@schematics/angular:pipe": { "typeSeparator": "." },
    "@schematics/angular:resolver": { "typeSeparator": "." }
  },
  "cli": {
    "schematicCollections": [
      "@ngrx/schematics",
      "@cypress/schematic",
      "@schematics/angular"
    ],
    "analytics": false
  }
}
