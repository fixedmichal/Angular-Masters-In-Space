/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/app",
    "types": [],
    "plugins": [
      {
        "name": "@angular/language-service"
      }
    ]
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.html"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
